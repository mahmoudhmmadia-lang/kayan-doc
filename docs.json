{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "KayanOS - دليل المستخدم",
  "colors": {
    "primary": "#00A378",
    "light": "#1BC47D",
    "dark": "#00A378"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "languages": [
      {
        "language": "ar",
        "default": true,
        "groups": [
          {
