              "index",
              "introduction",
              "organization-setup",
              "human-resources",
              "technical-references"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo-full-black-DvfLzt3m.png",
    "dark": "/images/logo-full-white-Cd9R_MTv.png"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "اشترك",
      "href": "https://kayanos.app"
